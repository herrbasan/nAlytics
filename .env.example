# nAlytics configuration — copy to .env and adjust.
# .env is gitignored.

# Localhost port for the nAlytics HTTP server (reached only via nPort routes).
PORT=3110

# Allowed beacon origins → site label. Format: <origin>=<site>, comma-separated.
# Beacon POSTs with an Origin not listed here are counted as rejects, never logged.
# The site dimension comes from this mapping — never from the payload.
ORIGINS=https://raum.com=raum,https://www.raum.com=raum
